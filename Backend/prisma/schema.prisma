// Backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DIREKTUR
  KADIV
  KOORDINATOR
  STAF
}

enum Prioritas {
  LOW
  MEDIUM
  HIGH
}

enum StatusTiket {
  MENUNGGU_TRIASE
  DIPROSES
  SELESAI
  DITOLAK
}

enum StatusSop {
  MENUNGGU_VALIDASI
  DISAHKAN
  DIREVISI
}

// 1. TABEL DIVISI
model Divisi {
  id        Int          @id @default(autoincrement())
  nama      String       @unique
  users     User[]
  tickets   Ticket[]
  sops      DokumenSop[]
  createdAt DateTime     @default(now())
}

// 2. TABEL USER (Mendukung Login No HP & Integrasi WhatsApp Gateway)
model User {
  id       Int     @id @default(autoincrement())
  nama     String
  noHp     String  @unique
  email    String? @unique
  password String
  role     Role    @default(STAF)
  divisiId Int?
  divisi   Divisi? @relation(fields: [divisiId], references: [id])

  ticketsCreated   Ticket[]          @relation("TiketDibuat")
  ticketsAssigned  Ticket[]          @relation("TiketDitugaskan")
  sopsCreated      DokumenSop[]      @relation("SopDiajukan")
  auditLogs        AuditLog[]
  notificationLogs NotificationLog[]
  telegramLinkTokens TelegramLinkToken[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  telegramChatId String?  @unique
}

// 3. TABEL TICKET
model Ticket {
  id            Int         @id @default(autoincrement())
  judul         String
  deskripsi     String
  prioritas     Prioritas   @default(LOW)
  status        StatusTiket @default(MENUNGGU_TRIASE)
  deadline      DateTime?
  catatanRevisi String?

  pembuatId Int
  pembuat   User @relation("TiketDibuat", fields: [pembuatId], references: [id])

  pelaksanaId Int?
  pelaksana   User? @relation("TiketDitugaskan", fields: [pelaksanaId], references: [id])

  divisiId Int?
  divisi   Divisi? @relation(fields: [divisiId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationLogs NotificationLog[]
}

// 4. TABEL DOKUMEN SOP
model DokumenSop {
  id        Int       @id @default(autoincrement())
  nomorSop  String    @unique
  judul     String
  deskripsi String?
  fileUrl   String?
  status    StatusSop @default(MENUNGGU_VALIDASI)

  divisiId Int?
  divisi   Divisi? @relation(fields: [divisiId], references: [id])

  pengajuId Int
  pengaju   User @relation("SopDiajukan", fields: [pengajuId], references: [id])

  disahkanPada DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// 5. TABEL AUDIT LOG
model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  details    String
  createdAt  DateTime @default(now())
}

// 7. TABEL TOKEN PENGHUBUNG TELEGRAM
model TelegramLinkToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model NotificationLog {
  id             Int       @id @default(autoincrement())
  ticketId       Int
  recipientId    Int
  type           String
  status         String    @default("PENDING")
  message        String
  telegramChatId String
  dedupeKey      String    @unique
  attempts       Int       @default(0)
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  recipient User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([ticketId, type])
}
