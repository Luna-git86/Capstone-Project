// Backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DIREKTUR
  KADIV
  KOORDINATOR
  STAF
}

enum Prioritas {
  LOW
  MEDIUM
  HIGH
}

enum StatusTiket {
  MENUNGGU_TRIASE
  DIPROSES
  MENUNGGU_VALIDASI
  HOLD_ESKALASI
  SELESAI
  DITOLAK
}

model Divisi {
  id          Int          @id @default(autoincrement())
  nama        String       @unique
  users       User[]
  tickets     Ticket[]
  dokumenSops DokumenSop[]
}

model User {
  id                  Int                 @id @default(autoincrement())
  nama                String
  email               String?             @unique
  noHp                String              @unique
  password            String
  telegramChatId      String?             @unique
  role                Role                @default(STAF)
  divisiId            Int?
  divisi              Divisi?             @relation(fields: [divisiId], references: [id])
  createdAt           DateTime            @default(now())

  tiketDibuat         Ticket[]            @relation("PembuatTiket")
  tiketDiawasi        Ticket[]            @relation("PenanggungJawabTiket")
  tiketDikerjakan     Ticket[]            @relation("PelaksanaTiket")
  dokumenSopDiajukan  DokumenSop[]        @relation("SopDiajukan")
  auditLogs           AuditLog[]
  telegramLinkTokens  TelegramLinkToken[]
  notificationLogs    NotificationLog[]
}

model Ticket {
  id                  Int               @id @default(autoincrement())
  judul               String
  lokasi              String?
  deskripsi           String
  prioritas           Prioritas         @default(MEDIUM)
  status              StatusTiket       @default(MENUNGGU_TRIASE)
  fotoInstruksi       String?           @db.Text
  laporanPenyelesaian String?           @db.Text
  fotoBukti           String?           @db.Text
  catatanRevisi       String?           @db.Text
  deadline            DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  completedAt         DateTime?
  jenisTiket  String   @default("LAPORAN") // Berisi "LAPORAN" atau "TUGAS"

  pembuatId           Int
  pembuat             User              @relation("PembuatTiket", fields: [pembuatId], references: [id])

  penanggungJawabId   Int?
  penanggungJawab     User?             @relation("PenanggungJawabTiket", fields: [penanggungJawabId], references: [id])

  divisiId            Int
  divisi              Divisi            @relation(fields: [divisiId], references: [id])

  pelaksanaId         Int?
  pelaksana           User?             @relation("PelaksanaTiket", fields: [pelaksanaId], references: [id])

  parentTicketId      Int?
  parentTicket        Ticket?           @relation("TicketHierarchy", fields: [parentTicketId], references: [id], onDelete: SetNull)
  childTickets        Ticket[]          @relation("TicketHierarchy")

  notificationLogs    NotificationLog[]
}

model DokumenSop {
  id           Int       @id @default(autoincrement())
  nomorSop     String    @unique
  judul        String
  revisi       String    
  deskripsi    String?
  fileUrl      String?
  status       String    @default("AKTIF")
  divisiId     Int?
  divisi       Divisi?   @relation(fields: [divisiId], references: [id])
  pengajuId    Int
  pengaju      User      @relation("SopDiajukan", fields: [pengajuId], references: [id], onDelete: Cascade)
  disahkanPada DateTime? @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  details    String?
  createdAt  DateTime @default(now())
}

model TelegramLinkToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model NotificationLog {
  id             Int       @id @default(autoincrement())
  ticketId       Int
  recipientId    Int
  type           String    @default("STATUS_CHANGED")
  status         String    @default("PENDING")
  message        String    @db.Text
  telegramChatId String?
  dedupeKey      String?   @unique
  attempts       Int       @default(0)
  errorMessage   String?   @db.Text
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  ticket         Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  recipient      User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([ticketId, type])
}