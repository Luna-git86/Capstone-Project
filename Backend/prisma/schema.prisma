// Backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DIREKTUR
  KADIV
  KOORDINATOR
  STAF
}

enum Prioritas {
  LOW
  MEDIUM
  HIGH
}

enum StatusTiket {
  MENUNGGU_TRIASE
  DIPROSES
  MENUNGGU_VALIDASI
  HOLD_ESKALASI
  SELESAI
  DITOLAK
}

enum StatusSop {
  MENUNGGU_VALIDASI
  DISAHKAN
  DIREVISI
}

model Divisi {
  id        Int          @id @default(autoincrement())
  nama      String       @unique
  users     User[]
  tickets   Ticket[]
  sops      DokumenSop[]
  createdAt DateTime     @default(now())
}

model User {
  id                 Int                 @id @default(autoincrement())
  nama               String
  noHp               String              @unique
  email              String?             @unique
  password           String
  role               Role                @default(STAF)
  divisiId           Int?
  divisi             Divisi?             @relation(fields: [divisiId], references: [id])
  ticketsCreated     Ticket[]            @relation("TiketDibuat")
  ticketsResponsible Ticket[]            @relation("TiketPenanggungJawab")
  ticketsAssigned    Ticket[]            @relation("TiketDitugaskan")
  sopsCreated        DokumenSop[]        @relation("SopDiajukan")
  auditLogs          AuditLog[]
  notificationLogs   NotificationLog[]
  telegramLinkTokens TelegramLinkToken[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  telegramChatId     String?             @unique
}

model Ticket {
  id                  Int               @id @default(autoincrement())
  judul               String
  lokasi              String?           // Lokasi ruangan / nama aset
  deskripsi           String
  prioritas           Prioritas         @default(LOW)
  status              StatusTiket       @default(MENUNGGU_TRIASE)
  deadline            DateTime?         // Menyimpan tanggal beserta jam & menit
  completedAt         DateTime?
  laporanPenyelesaian String?           // Keterangan penyelesaian dari staf
  fotoBukti           String?           // Foto bukti pengerjaan (Base64 / URL)
  catatanRevisi       String?           // Catatan evaluasi atasan (jika revisi) atau kendala biaya
  pembuatId           Int
  pembuat             User              @relation("TiketDibuat", fields: [pembuatId], references: [id])
  penanggungJawabId   Int?
  penanggungJawab     User?             @relation("TiketPenanggungJawab", fields: [penanggungJawabId], references: [id])
  pelaksanaId         Int?
  pelaksana           User?             @relation("TiketDitugaskan", fields: [pelaksanaId], references: [id])
  divisiId            Int?
  divisi              Divisi?           @relation(fields: [divisiId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  notificationLogs    NotificationLog[]
}

model DokumenSop {
  id           Int       @id @default(autoincrement())
  nomorSop     String    @unique
  judul        String
  revisi       String    @default("Revisi 1")
  deskripsi    String?
  fileUrl      String?
  status       StatusSop @default(DISAHKAN)
  divisiId     Int?
  divisi       Divisi?   @relation(fields: [divisiId], references: [id])
  pengajuId    Int
  pengaju      User      @relation("SopDiajukan", fields: [pengajuId], references: [id])
  disahkanPada DateTime? @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  details    String
  createdAt  DateTime @default(now())
}

model TelegramLinkToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model NotificationLog {
  id             Int       @id @default(autoincrement())
  ticketId       Int
  recipientId    Int
  type           String
  status         String    @default("PENDING")
  message        String
  telegramChatId String
  dedupeKey      String    @unique
  attempts       Int       @default(0)
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  ticket         Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  recipient      User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([ticketId, type])
}